{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://then.local/schemas/plugin-manifest-v1.json",
  "title": "Then Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "main", "icon", "permissions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9.-]+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "main": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "document:read",
          "document:selection",
          "document:navigate",
          "document:anchors",
          "views",
          "statusbar",
          "storage",
          "commands"
        ]
      }
    }
  }
}
