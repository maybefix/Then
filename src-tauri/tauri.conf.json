{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Then",
  "version": "0.7.0",
  "identifier": "local.then",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Then",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com",
        "style-src": "'self' 'unsafe-inline' https://cdnjs.cloudflare.com",
        "img-src": "'self' data: blob: http: https: http://then-image.localhost http://then-cover.localhost",
        "font-src": "'self' data: https://cdnjs.cloudflare.com",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: http://then-image.localhost http://then-cover.localhost",
        "worker-src": "'self' blob:",
        "frame-src": "'self' data: blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["script-src", "style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../THIRD_PARTY_LICENSES/NotoCJK-OFL.txt": "THIRD_PARTY_LICENSES/NotoCJK-OFL.txt",
      "../THIRD_PARTY_LICENSES/AGPL-3.0.txt": "THIRD_PARTY_LICENSES/AGPL-3.0.txt",
      "../THIRD_PARTY_LICENSES/Vivliostyle-NOTICE.md": "THIRD_PARTY_LICENSES/Vivliostyle-NOTICE.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
