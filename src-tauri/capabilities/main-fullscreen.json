{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-fullscreen",
  "description": "Allows the main editor window to enter and leave native fullscreen.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-set-fullscreen",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize"
  ]
}
